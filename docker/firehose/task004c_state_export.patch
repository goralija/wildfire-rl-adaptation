+// Emit a machine-readable terminal receipt before the process exits. Cell IDs
+// are one-based row-major, matching Cell2Fire's CSV and action protocol.
+void Cell2Fire::reportTerminalState(){
+	if (!this->done || this->terminalStateReported) return;
+	if (this->terminationReason.empty()) {
+		if (this->year > this->args.TotalYears) this->terminationReason = "weather_horizon";
+		else if (this->availCells.empty()) this->terminationReason = "grid_exhausted";
+		else if (this->burningCells.empty()) this->terminationReason = "front_extinguished";
+		else this->terminationReason = "upstream_terminal_unclassified";
+	}
+
+	std::vector<int> active = this->terminalActiveCells;
+	if (active.empty()) active.assign(this->burningCells.begin(), this->burningCells.end());
+	std::vector<int> affected(this->burntCells.begin(), this->burntCells.end());
+	std::vector<int> treated(this->harvestCells.begin(), this->harvestCells.end());
+	auto sortIds = [](std::vector<int>& ids) { std::sort(ids.begin(), ids.end()); };
+	sortIds(active);
+	sortIds(affected);
+	sortIds(treated);
+	auto printIds = [](const std::vector<int>& ids) {
+		std::cout << "[";
+		for (std::size_t index = 0; index < ids.size(); ++index) {
+			if (index) std::cout << ",";
+			std::cout << ids[index];
+		}
+		std::cout << "]";
+	};
+	int finalFirePeriod = 0;
+	if (this->year >= 1 && this->year <= static_cast<int>(this->fire_period.size())) {
+		finalFirePeriod = this->fire_period[this->year - 1];
+	} else if (this->year > this->args.TotalYears) {
+		finalFirePeriod = this->args.MaxFirePeriods;
+	}
+
+	std::cout << "FIREHOSE_TERMINAL_STATE {\"schema\":\"firehose-terminal-state-v1\","
+	          << "\"reason\":\"" << this->terminationReason << "\","
+	          << "\"cell_id_base\":1,\"active_front_ncells\":";
+	printIds(active);
+	std::cout << ",\"ever_affected_ncells\":";
+	printIds(affected);
+	std::cout << ",\"treated_ncells\":";
+	printIds(treated);
+	std::cout << ",\"available_cell_count\":" << this->availCells.size()
+	          << ",\"total_cell_count\":" << this->nCells
+	          << ",\"fire_period\":" << finalFirePeriod
+	          << ",\"weather_period\":" << this->weatherPeriod << "}" << std::endl;
+	this->terminalStateReported = true;
+}
+
