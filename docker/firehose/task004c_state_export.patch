-        return obs, reward, done, {}
+        return obs, reward, done, info
+
+    def _episode_info(self, terminated):
+        """Return explicit simulator termination metadata without changing rewards."""
+        ever_affected = sorted(
+            int(row * self.width + col + 1) for row, col in self.cells_burned
+        )
+        active_front = sorted(
+            int(row * self.width + col + 1) for row, col in self.cells_on_fire
+        )
+        terminal_prefix = "FIREHOSE_TERMINAL_STATE "
+        terminal = None
+        for line in reversed(self.fire_process.lines):
+            if line.startswith(terminal_prefix):
+                terminal = json.loads(line[len(terminal_prefix):])
+                break
+        if terminal is not None:
+            # The categorical output grid gives treatment precedence (-1), so a
+            # fire-affected cell can disappear from Python's positive-grid
+            # counter when it is treated in the same simulator interval. The
+            # terminal C++ sets are authoritative for episode totals/front.
+            self.cells_burned.update(
+                ((cell_id - 1) // self.width, (cell_id - 1) % self.width)
+                for cell_id in terminal["ever_affected_ncells"]
+            )
+            self.cells_on_fire = {
+                ((cell_id - 1) // self.width, (cell_id - 1) % self.width)
+                for cell_id in terminal["active_front_ncells"]
+            }
+            self.cells_harvested.update(
+                ((cell_id - 1) // self.width, (cell_id - 1) % self.width)
+                for cell_id in terminal["treated_ncells"]
+            )
+            ever_affected = sorted(
+                int(row * self.width + col + 1) for row, col in self.cells_burned
+            )
+            active_front = sorted(
+                int(row * self.width + col + 1) for row, col in self.cells_on_fire
+            )
+            return {
+                "termination_reason": terminal["reason"],
+                "simulator_terminal": True,
+                "terminal_state": terminal,
+                "ever_affected_cells": len(ever_affected),
+                "active_front_cells": len(active_front),
+                "ever_affected_cell_ids_one_based": ever_affected,
+                "active_front_cell_ids_one_based": active_front,
+            }
+        if not terminated:
+            return {}
+        if self.fire_process.finished:
+            reason = "upstream_terminal_unclassified"
+        elif self.iter >= self.max_steps:
+            reason = "adapter_step_limit"
+        elif self.fire_process.process is not None and self.fire_process.process.poll() is not None:
+            reason = "subprocess_error"
+        else:
+            reason = "simulator_output_missing"
+        return {
+            "termination_reason": reason,
+            "simulator_terminal": False,
+            "ever_affected_cells": len(ever_affected),
+            "active_front_cells": len(active_front),
+            "ever_affected_cell_ids_one_based": ever_affected,
+            "active_front_cell_ids_one_based": active_front,
+        }
